# Copy to .env for local development. Never commit the real .env file.

# "production" turns on secure cookies, HSTS and proxy handling, and requires SECRET_KEY.
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Book data. NYT powers the bestseller shelves; the app still works without it.
# https://developer.nytimes.com/  and  https://console.cloud.google.com/apis/library/books.googleapis.com
NYT_API_KEY=
GOOGLE_API_KEY=

# Leave empty to use SQLite (instance/books.db). Set to a Postgres URL when deployed.
DATABASE_URL=

# Optional. For several servers, point these at Redis.
# CACHE_TYPE=RedisCache
# RATELIMIT_STORAGE_URI=redis://localhost:6379
